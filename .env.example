# Postgres Database Credentials
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=secret
POSTGRES_DB=langfuse

# Langfuse Secrets
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=secret
SALT=secret
ENCRYPTION_KEY=secret # Recommended by Langfuse for API key encryption (Generate a 32-byte hex key for production)
TELEMETRY_ENABLED=false

# -----------------------------------------------------------
# Application Configuration (To be used by Python/Go services)
# -----------------------------------------------------------
LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-... (Generate these in Langfuse UI)
# LANGFUSE_SECRET_KEY=sk-lf-...
